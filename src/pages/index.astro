<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Il Tempo di New York</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Franklin+Gothic+Medium:ital@0;1&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --black:     #121212;
      --ink:       #333333;
      --muted:     #6e6e6e;
      --rule:      #e2e2e2;
      --rule-dark: #adadad;
      --bg:        #ffffff;
      --accent:    #c9303a;
      --col-max:   730px;
    }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'Source Serif 4', Georgia, serif;
      font-size: 18px;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    .nyt-topbar {
      border-bottom: 1px solid var(--rule-dark);
      padding: 10px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .nyt-topbar-left, .nyt-topbar-right {
      display: flex; gap: 18px; align-items: center;
      font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
      font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted);
    }
    .nyt-topbar-left a, .nyt-topbar-right a { color: inherit; text-decoration: none; }
    .nyt-topbar-left a:hover, .nyt-topbar-right a:hover { color: var(--black); }
    .nyt-logo {
      font-family: 'Playfair Display', 'Times New Roman', serif;
      font-size: 28px; font-weight: 900; letter-spacing: -.5px;
      color: var(--black); text-decoration: none; white-space: nowrap;
    }
    .nyt-sections {
      border-bottom: 2px solid var(--black);
      border-top: 1px solid var(--rule-dark);
      overflow-x: auto; scrollbar-width: none;
    }
    .nyt-sections::-webkit-scrollbar { display: none; }
    .nyt-sections ul { display: flex; list-style: none; padding: 0 24px; }
    .nyt-sections li a {
      display: block; padding: 10px 14px;
      font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
      font-size: 13px; letter-spacing: .05em; text-transform: uppercase;
      color: var(--black); text-decoration: none; white-space: nowrap;
    }
    .nyt-sections li a:hover { color: var(--accent); }
    .nyt-sections li.active a { color: var(--accent); border-bottom: 3px solid var(--accent); }
    .nyt-datebar {
      padding: 8px 24px; border-bottom: 1px solid var(--rule);
      font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
      font-size: 12px; letter-spacing: .04em; color: var(--muted);
      display: flex; justify-content: space-between; align-items: center;
    }
    .article-wrapper { max-width: 1080px; margin: 0 auto; padding: 40px 24px; }
    .article-section-label {
      font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
      font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 16px; display: block;
    }
    .article-headline {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: clamp(28px, 4vw, 46px); font-weight: 700;
      line-height: 1.12; letter-spacing: -.3px;
      color: var(--black); max-width: var(--col-max); margin-bottom: 18px;
    }
    .article-deck {
      font-family: 'Source Serif 4', Georgia, serif;
      font-size: clamp(17px, 2.2vw, 21px); font-weight: 300;
      line-height: 1.4; color: var(--ink);
      max-width: var(--col-max); margin-bottom: 28px;
    }
    .article-byline {
      border-top: 3px solid var(--black); border-bottom: 1px solid var(--rule-dark);
      padding: 10px 0; max-width: var(--col-max); margin-bottom: 24px;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 8px;
    }
    .byline-author {
      font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
      font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--black);
    }
    .byline-author a { color: inherit; text-decoration: none; font-weight: bold; }
    .byline-author a:hover { text-decoration: underline; }
    .byline-meta {
      font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
      font-size: 12px; color: var(--muted); letter-spacing: .03em;
    }
    .article-share {
      display: flex; gap: 10px; max-width: var(--col-max);
      margin-bottom: 32px; align-items: center;
    }
    .share-btn {
      display: flex; align-items: center; gap: 6px; padding: 7px 14px;
      border: 1px solid var(--rule-dark); background: transparent; cursor: pointer;
      font-family: 'Franklin Gothic Medium', Arial, sans-serif;
      font-size: 12px; letter-spacing: .05em; text-transform: uppercase;
      color: var(--ink); border-radius: 2px; transition: background .15s, color .15s;
    }
    .share-btn:hover { background: var(--black); color: #fff; }
    .share-btn svg { flex-shrink: 0; }
    .gift-btn {
      margin-left: auto; font-style: italic; font-family: Georgia, serif;
      font-size: 13px; text-transform: none; letter-spacing: 0; border-color: var(--rule);
    }
    .article-hero { max-width: var(--col-max); margin-bottom: 8px; }
    .article-hero img { width: 100%; display: block; }
    .article-caption {
      font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
      font-size: 12px; color: var(--muted); line-height: 1.5;
      max-width: var(--col-max); margin-bottom: 36px;
      padding-top: 6px; border-top: 1px solid var(--rule);
    }
    .article-caption em { display: block; margin-top: 3px; font-style: normal; color: #aaa; }
    .article-body { max-width: var(--col-max); }
    .article-body p {
      margin-bottom: 26px; font-size: 18px; font-weight: 300; color: var(--ink);
    }
    .article-body p:first-child::first-letter {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 76px; font-weight: 900; float: left;
      line-height: .8; margin-right: 6px; margin-top: 6px; color: var(--black);
    }
    .article-body h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 24px; font-weight: 700; color: var(--black);
      margin: 40px 0 14px; line-height: 1.25;
    }
    .article-body blockquote {
      border-left: 4px solid var(--accent);
      margin: 36px 0; padding: 4px 24px;
      font-size: 22px; font-style: italic; font-weight: 400;
      color: var(--black); line-height: 1.45;
    }
    .article-body blockquote cite {
      display: block; margin-top: 10px; font-size: 13px; font-style: normal;
      font-family: 'Franklin Gothic Medium', Arial, sans-serif;
      letter-spacing: .05em; text-transform: uppercase; color: var(--muted);
    }
    .article-body .pullquote {
      border: none; border-top: 3px solid var(--black); border-bottom: 1px solid var(--rule-dark);
      margin: 40px 0; padding: 18px 0 16px;
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 26px; font-weight: 700; font-style: normal;
      color: var(--black); line-height: 1.3;
    }
    .article-body .pullquote cite {
      font-size: 13px; font-family: 'Franklin Gothic Medium', Arial, sans-serif;
      font-weight: normal; font-style: normal;
      letter-spacing: .06em; text-transform: uppercase;
      color: var(--muted); display: block; margin-top: 10px;
    }
    .cartello {
      background: #fffdf5; border: 1px solid #d4c89a;
      border-left: 4px solid #b5a04a;
      margin: 32px 0; padding: 20px 28px;
      font-family: Georgia, serif; font-size: 20px;
      font-style: italic; color: #3a3220; line-height: 1.6;
    }
    .article-inline-img { margin: 36px 0 6px; }
    .article-inline-img img { width: 100%; display: block; }
    .article-inline-img figcaption {
      font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
      font-size: 12px; color: var(--muted); padding-top: 6px;
      border-top: 1px solid var(--rule); line-height: 1.5; margin-bottom: 28px;
    }
    .article-tags {
      margin-top: 48px; border-top: 2px solid var(--black);
      padding-top: 16px; display: flex; flex-wrap: wrap; gap: 8px;
    }
    .article-tags a {
      display: inline-block; border: 1px solid var(--rule-dark);
      padding: 5px 12px;
      font-family: 'Franklin Gothic Medium', Arial, sans-serif;
      font-size: 12px; letter-spacing: .05em; text-transform: uppercase;
      color: var(--black); text-decoration: none; border-radius: 2px;
    }
    .article-tags a:hover { background: var(--black); color: #fff; border-color: var(--black); }
    .related-section {
      max-width: var(--col-max); margin-top: 52px;
      border-top: 3px solid var(--black); padding-top: 20px;
    }
    .related-label {
      font-family: 'Franklin Gothic Medium', Arial, sans-serif;
      font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 16px;
    }
    .related-list { list-style: none; display: flex; flex-direction: column; gap: 14px; }
    .related-list li { border-bottom: 1px solid var(--rule); padding-bottom: 14px; }
    .related-list li:last-child { border-bottom: none; padding-bottom: 0; }
    .related-list a {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 17px; font-weight: 700; color: var(--black);
      text-decoration: none; line-height: 1.3;
    }
    .related-list a:hover { text-decoration: underline; }
    .related-list small {
      display: block; margin-top: 3px;
      font-family: 'Franklin Gothic Medium', Arial, sans-serif;
      font-size: 12px; color: var(--muted); letter-spacing: .03em;
    }
    footer {
      margin-top: 80px; border-top: 3px solid var(--black);
      padding: 28px 24px 48px; text-align: center;
    }
    footer .footer-logo {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 26px; font-weight: 900; color: var(--black);
      display: block; margin-bottom: 14px;
    }
    footer nav {
      display: flex; flex-wrap: wrap; justify-content: center;
      gap: 6px 18px;
      font-family: 'Franklin Gothic Medium', Arial, sans-serif;
      font-size: 11px; letter-spacing: .05em; text-transform: uppercase; color: var(--muted);
    }
    footer nav a { color: inherit; text-decoration: none; }
    footer nav a:hover { color: var(--black); }
    footer .footer-copy {
      margin-top: 20px;
      font-family: 'Franklin Gothic Medium', Arial, sans-serif;
      font-size: 11px; color: var(--muted); letter-spacing: .03em;
    }
    @media (max-width: 640px) {
      .nyt-topbar-left, .nyt-topbar-right { display: none; }
      .nyt-logo { font-size: 22px; }
      .article-wrapper { padding: 24px 16px; }
      .article-body p:first-child::first-letter { font-size: 56px; }
      .share-btn span { display: none; }
    }
  </style>
</head>
